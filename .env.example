# LLM backend: claude_code (Claude subscription via Claude Code, for local dev/eval)
#              anthropic_api (API key, for any demo shared with others)
LLM_BACKEND=claude_code

# Only set when LLM_BACKEND=anthropic_api. Must NOT be set in claude_code mode,
# otherwise usage is billed to the API instead of the subscription.
# ANTHROPIC_API_KEY=

MODEL_ANSWER=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
LLM_MAX_CONCURRENCY=4

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
