# LLM backend: claude_code (Claude subscription via Claude Code, for local dev/eval)
#              anthropic_api (API key, for any demo shared with others)
LLM_BACKEND=claude_code

# Only set when LLM_BACKEND=anthropic_api. Must NOT be set in claude_code mode,
# otherwise usage is billed to the API instead of the subscription.
# ANTHROPIC_API_KEY=

MODEL_ANSWER=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
LLM_MAX_CONCURRENCY=4

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Langfuse (optional): scripts/export_langfuse.py loads finished runs into Langfuse.
# Local stack: `docker compose --profile observability up -d`, then
# LANGFUSE_HOST=http://localhost:3300. The two keys are also the local project's API
# keys, created headlessly on first start; pick them yourself, e.g.
#   pk-lf-$(openssl rand -hex 16)   and   sk-lf-$(openssl rand -hex 32)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Local Langfuse stack only (docker compose profile `observability`). Generate each
# secret with `openssl rand -hex 32` (hex keeps the database URL valid); the
# ENCRYPTION_KEY must be exactly that: 64 hex characters. The stack does not start
# with these empty.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
